{
  "name": "inventia",
  "version": "1.0.0",
  "private": true,
  "description": "Inventia: sistema de inventario multisede con predicción de demanda para PyMEs.",
  "engines": { "node": ">=20" },
  "scripts": {
    "setup": "node scripts/instalar.mjs",
    "dev": "concurrently -n API,WEB -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node scripts/python.mjs -m uvicorn app.main:app --reload",
    "dev:frontend": "npm --prefix frontend run dev",
    "migrar": "node scripts/python.mjs -m alembic upgrade head",
    "demo": "node scripts/python.mjs -m app.cli cargar-demo --con-prediccion",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "node scripts/python.mjs -m pytest",
    "test:frontend": "npm --prefix frontend test",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "build": "npm --prefix frontend run build",
    "tipos": "npm --prefix frontend run tipos",
    "docker:up": "docker compose -f infra/docker-compose.yml --env-file infra/.env up -d --build",
    "docker:down": "docker compose -f infra/docker-compose.yml --env-file infra/.env down"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
