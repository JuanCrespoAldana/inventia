# Configuración del backend de Inventia. Copie este archivo como `.env` y complete los valores.
# NUNCA suba el archivo `.env` real a Git ni lo comparta: contiene credenciales.

# --- Aplicación ---------------------------------------------------------------------------------------------
# development | production | test. En producción SETUP_TOKEN es obligatorio y se desactiva el modo de desarrollo.
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_TIMEZONE=America/Bogota
# Active solo detrás de un proxy de confianza (nginx, balanceador) que reescriba X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# --- Base de datos ------------------------------------------------------------------------------------------
# PostgreSQL con el controlador asíncrono. Ejemplos:
#   local:   postgresql+asyncpg://inventia:CLAVE@localhost:5432/inventia
#   Neon:    postgresql+asyncpg://USUARIO:CLAVE@ep-xxxx.region.aws.neon.tech/neondb
DATABASE_URL=postgresql+asyncpg://inventia:cambie_esta_clave@localhost:5432/inventia
# auto = exige SSL para servidores remotos y lo desactiva en localhost / red de Docker. true | false para forzar.
DATABASE_SSL=auto
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# --- Seguridad ----------------------------------------------------------------------------------------------
# Mínimo 32 caracteres. Genere una con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Protege la pantalla de configuración inicial (creación de la primera empresa y su administrador).
# Obligatorio en producción (mínimo 16 caracteres). Se escribe en la pantalla «Configuración inicial» (o se usa `python -m app.cli inicializar`).
SETUP_TOKEN=

# --- CORS / frontend ----------------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
# Orígenes adicionales permitidos, separados por coma (opcional).
CORS_ORIGINS=

# --- Correo para recuperar contraseñas (opcional pero recomendado) ------------------------------------------
# Con Gmail use una «contraseña de aplicación», no la contraseña de la cuenta.
# SMTP_USER, SMTP_PASSWORD y EMAIL_FROM son TODOS necesarios para enviar. Si falta alguno, no se envía nada y, solo en
# desarrollo, el código de recuperación aparece en la consola del backend. Ejemplo de EMAIL_FROM: Inventia <usted@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Predicción de demanda ----------------------------------------------------------------------------------
ML_MAX_SERIES_POR_EJECUCION=5000
ML_TIEMPO_MAXIMO_SEGUNDOS=900
ML_HISTORIA_MAXIMA_DIAS=365
