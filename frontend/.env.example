# Variables del frontend (Vite las incrusta al compilar; no pueden contener secretos).
# En desarrollo no hace falta definir nada: Vite redirige /api hacia el backend.

# Destino del proxy de desarrollo (npm run dev / npm run preview). Por defecto http://localhost:8000
# VITE_PROXY_API=http://localhost:8000

# URL base de la API si el frontend se sirve desde otro dominio. Vacío = mismo origen (recomendado).
# VITE_API_URL=

# Formato de números, fechas y moneda.
# VITE_LOCALE=es-CO
# VITE_MONEDA=COP
