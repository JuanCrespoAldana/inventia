# Variables para Docker Compose (infra/docker-compose.yml). Copie como `infra/.env` y complete.
# NUNCA suba `infra/.env` a Git. Genere cada secreto con:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Obligatorias -------------------------------------------------------------------------------------------
# Use solo letras, números, - y _ (la contraseña se incrusta en la URL de conexión).
POSTGRES_PASSWORD=
SECRET_KEY=
# Token que se pide en la pantalla de configuración inicial para crear la primera empresa y su administrador.
SETUP_TOKEN=

# --- Opcionales ---------------------------------------------------------------------------------------------
POSTGRES_DB=inventia
POSTGRES_USER=inventia
# Puerto de la interfaz web y puerto local de PostgreSQL (solo accesible desde esta máquina).
WEB_PORT=8080
DB_PORT=5432
# URL pública desde la que se usará el sistema (se usa para CORS y enlaces).
PUBLIC_URL=http://localhost:8080
APP_TIMEZONE=America/Bogota
LOG_LEVEL=INFO

# Correo para recuperar contraseñas (con Gmail use una «contraseña de aplicación»).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
