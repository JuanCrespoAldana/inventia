digraph relacional_sig_entradas {
  graph [rankdir=LR, fontname="Inter", nodesep=0.35, ranksep=0.9, pad=0.3, bgcolor="white", splines=true, concentrate=false];
  node [shape=plain, fontname="Inter"];
  edge [color="#52514e", arrowtail=crowodot, arrowhead=tee, dir=both, arrowsize=0.7, penwidth=0.9];
  entradas_inventario [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#3b5bf0"><tr><td colspan="3" bgcolor="#3b5bf0"><font color="white" point-size="10"><b>entradas_inventario</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="empresa_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">empresa_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="sede_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">sede_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="numero"><font point-size="8"> </font></td><td align="left"><font point-size="9">numero</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="motivo"><font point-size="8"> </font></td><td align="left"><font point-size="9">motivo</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(40)</font></td></tr><tr><td align="left" port="usuario_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">usuario_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="fecha"><font point-size="8"> </font></td><td align="left"><font point-size="9">fecha</font></td><td align="left"><font color="#7b7e8c" point-size="8">timestamptz</font></td></tr><tr><td></td><td align="left" colspan="2"><font color="#9a9890" point-size="8"><i>(+1 columnas más)</i></font></td></tr></table>>];
  entrada_observaciones [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#3b5bf0"><tr><td colspan="3" bgcolor="#3b5bf0"><font color="white" point-size="10"><b>entrada_observaciones</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">bigint</font></td></tr><tr><td align="left" port="entrada_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">entrada_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="producto_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">producto_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int ?</font></td></tr><tr><td align="left" port="usuario_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">usuario_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="fecha"><font point-size="8"> </font></td><td align="left"><font point-size="9">fecha</font></td><td align="left"><font color="#7b7e8c" point-size="8">timestamptz</font></td></tr><tr><td align="left" port="contenido"><font point-size="8"> </font></td><td align="left"><font point-size="9">contenido</font></td><td align="left"><font color="#7b7e8c" point-size="8">text</font></td></tr></table>>];
  sedes [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#9a9890"><tr><td colspan="3" bgcolor="#9a9890"><font color="white" point-size="10"><b>sedes</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="nombre"><font point-size="8"> </font></td><td align="left"><font point-size="9">nombre</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(150)</font></td></tr></table>>];
  usuarios [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#9a9890"><tr><td colspan="3" bgcolor="#9a9890"><font color="white" point-size="10"><b>usuarios</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="nombre"><font point-size="8"> </font></td><td align="left"><font point-size="9">nombre</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(150)</font></td></tr></table>>];
  movimientos [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#9a9890"><tr><td colspan="3" bgcolor="#9a9890"><font color="white" point-size="10"><b>movimientos</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">bigint</font></td></tr><tr><td align="left" port="tipo"><font point-size="8"> </font></td><td align="left"><font point-size="9">tipo</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(30)</font></td></tr></table>>];
  no_conformidades [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#9a9890"><tr><td colspan="3" bgcolor="#9a9890"><font color="white" point-size="10"><b>no_conformidades</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="numero"><font point-size="8"> </font></td><td align="left"><font point-size="9">numero</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr></table>>];
  entradas_inventario -> sedes [arrowhead=tee];
  entradas_inventario -> usuarios [arrowhead=tee];
  entrada_observaciones -> entradas_inventario [arrowhead=tee];
  entrada_observaciones -> usuarios [arrowhead=tee];
}