  movimientos [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#3b5bf0"><tr><td colspan="3" bgcolor="#3b5bf0"><font color="white" point-size="10"><b>movimientos</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">bigint</font></td></tr><tr><td align="left" port="empresa_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">empresa_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="sede_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">sede_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="producto_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">producto_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="tipo"><font point-size="8"> </font></td><td align="left"><font point-size="9">tipo</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(30)</font></td></tr><tr><td align="left" port="delta"><font point-size="8"> </font></td><td align="left"><font point-size="9">delta</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="saldo_anterior"><font point-size="8"> </font></td><td align="left"><font point-size="9">saldo_anterior</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="saldo_posterior"><font point-size="8"> </font></td><td align="left"><font point-size="9">saldo_posterior</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="sede_contraparte_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">sede_contraparte_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int ?</font></td></tr><tr><td align="left" port="usuario_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">usuario_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="fecha"><font point-size="8"> </font></td><td align="left"><font point-size="9">fecha</font></td><td align="left"><font color="#7b7e8c" point-size="8">timestamptz</font></td></tr><tr><td align="left" port="venta_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">venta_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int ?</font></td></tr><tr><td align="left" port="traslado_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">traslado_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int ?</font></td></tr><tr><td align="left" port="entrada_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">entrada_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int ?</font></td></tr><tr><td></td><td align="left" colspan="2"><font color="#9a9890" point-size="8"><i>(+3 columnas más)</i></font></td></tr></table>>];
  alertas [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#3b5bf0"><tr><td colspan="3" bgcolor="#3b5bf0"><font color="white" point-size="10"><b>alertas</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">bigint</font></td></tr><tr><td align="left" port="empresa_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">empresa_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="sede_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">sede_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="producto_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">producto_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="tipo"><font point-size="8"> </font></td><td align="left"><font point-size="9">tipo</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(30)</font></td></tr><tr><td align="left" port="prioridad"><font point-size="8"> </font></td><td align="left"><font point-size="9">prioridad</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(10)</font></td></tr><tr><td align="left" port="estado"><font point-size="8"> </font></td><td align="left"><font point-size="9">estado</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(10)</font></td></tr><tr><td align="left" port="abierta_en"><font point-size="8"> </font></td><td align="left"><font point-size="9">abierta_en</font></td><td align="left"><font color="#7b7e8c" point-size="8">timestamptz</font></td></tr><tr><td align="left" port="resuelta_en"><font point