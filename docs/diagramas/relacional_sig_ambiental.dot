digraph relacional_sig_ambiental {
  graph [rankdir=LR, fontname="Inter", nodesep=0.35, ranksep=0.9, pad=0.3, bgcolor="white", splines=true, concentrate=false];
  node [shape=plain, fontname="Inter"];
  edge [color="#52514e", arrowtail=crowodot, arrowhead=tee, dir=both, arrowsize=0.7, penwidth=0.9];
  amb_configuracion [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#3b5bf0"><tr><td colspan="3" bgcolor="#3b5bf0"><font color="white" point-size="10"><b>amb_configuracion</b></font></td></tr><tr><td align="left" port="empresa_id"><font color="#184f95" point-size="8"><b>PK, FK</b></font></td><td align="left"><font point-size="9">empresa_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="factor_red_kgco2_kwh"><font point-size="8"> </font></td><td align="left"><font point-size="9">factor_red_kgco2_kwh</font></td><td align="left"><font color="#7b7e8c" point-size="8">numeric(10,5) ?</font></td></tr><tr><td align="left" port="factor_red_anio"><font point-size="8"> </font></td><td align="left"><font point-size="9">factor_red_anio</font></td><td align="left"><font color="#7b7e8c" point-size="8">int ?</font></td></tr><tr><td align="left" port="factor_red_fuente"><font point-size="8"> </font></td><td align="left"><font point-size="9">factor_red_fuente</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(500) ?</font></td></tr><tr><td align="left" port="actualizado_por"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">actualizado_por</font></td><td align="left"><font color="#7b7e8c" point-size="8">int ?</font></td></tr><tr><td></td><td align="left" colspan="2"><font color="#9a9890" point-size="8"><i>(+2 columnas más)</i></font></td></tr></table>>];
  amb_categorias [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#3b5bf0"><tr><td colspan="3" bgcolor="#3b5bf0"><font color="white" point-size="10"><b>amb_categorias</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="empresa_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">empresa_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="categoria_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">categoria_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="tipo_vehiculo"><font point-size="8"> </font></td><td align="left"><font point-size="9">tipo_vehiculo</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(30)</font></td></tr><tr><td align="left" port="propulsion"><font point-size="8"> </font></td><td align="left"><font point-size="9">propulsion</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(30)</font></td></tr><tr><td align="left" port="distancia_anual_km"><font point-size="8"> </font></td><td align="left"><font point-size="9">distancia_anual_km</font></td><td align="left"><font color="#7b7e8c" point-size="8">numeric(10,1) ?</font></td></tr><tr><td align="left" port="consumo_kwh_100km"><font point-size="8"> </font></td><td align="left"><font point-size="9">consumo_kwh_100km</font></td><td align="left"><font color="#7b7e8c" point-size="8">numeric(8,3) ?</font></td></tr><tr><td align="left" port="horizonte_anios"><font point-size="8"> </font></td><td align="left"><font point-size="9">horizonte_anios</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="actualizado_por"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">actualizado_por</font></td><td align="left"><font color="#7b7e8c" point-size="8">int ?</font></td></tr><tr><td></td><td align="left" colspan="2"><font color="#9a9890" point-size="8"><i>(+6 columnas más)</i></font></td></tr></table>>];
  amb_registros [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#3b5bf0"><tr><td colspan="3" bgcolor="#3b5bf0"><font color="white" point-size="10"><b>amb_registros</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">bigint</font></td></tr><tr><td align="left" port="empresa_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">empresa_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="venta_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">venta_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="venta_item_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">venta_item_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="sede_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">sede_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="producto_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">producto_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="categoria_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">categoria_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="fecha"><font point-size="8"> </font></td><td align="left"><font point-size="9">fecha</font></td><td align="left"><font color="#7b7e8c" point-size="8">date</font></td></tr><tr><td align="left" port="unidades"><font point-size="8"> </font></td><td align="left"><font point-size="9">unidades</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="estado"><font point-size="8"> </font></td><td align="left"><font point-size="9">estado</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(10)</font></td></tr><tr><td align="left" port="co2_evitado_kg"><font point-size="8"> </font></td><td align="left"><font point-size="9">co2_evitado_kg</font></td><td align="left"><font color="#7b7e8c" point-size="8">numeric(14,3) ?</font></td></tr><tr><td></td><td align="left" colspan="2"><font color="#9a9890" point-size="8"><i>(+6 columnas más)</i></font></td></tr></table>>];
  categorias [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#9a9890"><tr><td colspan="3" bgcolor="#9a9890"><font color="white" point-size="10"><b>categorias</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="nombre"><font point-size="8"> </font></td><td align="left"><font point-size="9">nombre</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(100)</font></td></tr></table>>];
  venta_items [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#9a9890"><tr><td colspan="3" bgcolor="#9a9890"><font color="white" point-size="10"><b>venta_items</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="cantidad"><font point-size="8"> </font></td><td align="left"><font point-size="9">cantidad</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr></table>>];
  ventas [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#9a9890"><tr><td colspan="3" bgcolor="#9a9890"><font color="white" point-size="10"><b>ventas</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="numero"><font point-size="8"> </font></td><td align="left"><font point-size="9">numero</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr></table>>];
  productos [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#9a9890"><tr><td colspan="3" bgcolor="#9a9890"><font color="white" point-size="10"><b>productos</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="codigo"><font point-size="8"> </font></td><td align="left"><font point-size="9">codigo</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(60)</font></td></tr></table>>];
  sedes [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#9a9890"><tr><td colspan="3" bgcolor="#9a9890"><font color="white" point-size="10"><b>sedes</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="nombre"><font point-size="8"> </font></td><td align="left"><font point-size="9">nombre</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(150)</font></td></tr></table>>];
  amb_categorias -> categorias [arrowhead=tee];
  amb_registros -> categorias [arrowhead=tee];
  amb_registros -> productos [arrowhead=tee];
  amb_registros -> sedes [arrowhead=tee];
  amb_registros -> ventas [arrowhead=tee];
  amb_registros -> venta_items [arrowhead=tee];
}