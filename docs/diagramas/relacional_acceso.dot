  auditoria [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#3b5bf0"><tr><td colspan="3" bgcolor="#3b5bf0"><font color="white" point-size="10"><b>auditoria</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">bigint</font></td></tr><tr><td align="left" port="empresa_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">empresa_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int ?</font></td></tr><tr><td align="left" port="usuario_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">usuario_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int ?</font></td></tr><tr><td align="left" port="sede_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">sede_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int ?</font></td></tr><tr><td align="left" port="fecha"><font point-size="8"> </font></td><td align="left"><font point-size="9">fecha</font></td><td align="left"><font color="#7b7e8c" point-size="8">timestamptz</font></td></tr><tr><td align="left" port="modulo"><font point-size="8"> </font></td><td align="left"><font point-size="9">modulo</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(40)</font></td></tr><tr><td align="left" port="accion"><font point-size="8"> </font></td><td align="left"><font point-size="9">accion</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(60)</font></td></tr><tr><td align="left" port="resultado"><font point-size="8"> </font></td><td align="left"><font point-size="9">resultado</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(10)</font></td></tr><tr><td></td><td align="left" colspan="2"><font color="#9a9890" point-size="8"><i>(+6 columnas más)</i></font></td></tr></table>>];
  api_keys [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#3b5bf0"><tr><td colspan="3" bgcolor="#3b5bf0"><font color="white" point-size="10"><b>api_keys</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="empresa_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">empresa_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="sede_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">sede_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int ?</font></td></tr><tr><td align="left" port="nombre"><font point-size="8"> </font></td><td align="left"><font point-size="9">nombre</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(100)</font></td></tr><tr><td align="left" port="prefijo"><font point-size="8"> </font></td><td align="left"><font point-size="9">prefijo</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(12)</font></td></tr><tr><td align="left" port="key_hash"><font point-size="8"> </font></td><td align="left"><font point-size="9">key_hash</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(64)</font></td></tr><tr><td align="left" port="alcances"><font point-size="8"> </font></td><td align="left"><font point-size="9">alcances</font></td><td align="left"><font color="#7b7e8c" point-size="8">jsonb</font></td></tr><tr><td align="left" port="activa"><font point-size="8"> </font></td><td align="left"><font point-size="9">activa</font></td><td align="left"><font color="#7b7e8c" point-size="8">bool</font></td></tr><tr><td align="left" port="creada_por"><font color="#eb6834" point-size="8"><b>FK</b></f