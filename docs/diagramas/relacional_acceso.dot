  rol_permisos [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#3b5bf0"><tr><td colspan="3" bgcolor="#3b5bf0"><font color="white" point-size="10"><b>rol_permisos</b></font></td></tr><tr><td align="left" port="rol_id"><font color="#184f95" point-size="8"><b>PK, FK</b></font></td><td align="left"><font point-size="9">rol_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="permiso_codigo"><font color="#184f95" point-size="8"><b>PK, FK</b></font></td><td align="left"><font point-size="9">permiso_codigo</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(80)</font></td></tr></table>>];
