digraph relacional_sig_sst {
  graph [rankdir=LR, fontname="Inter", nodesep=0.35, ranksep=0.9, pad=0.3, bgcolor="white", splines=true, concentrate=false];
  node [shape=plain, fontname="Inter"];
  edge [color="#52514e", arrowtail=crowodot, arrowhead=tee, dir=both, arrowsize=0.7, penwidth=0.9];
  sst_configuracion [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#3b5bf0"><tr><td colspan="3" bgcolor="#3b5bf0"><font color="white" point-size="10"><b>sst_configuracion</b></font></td></tr><tr><td align="left" port="empresa_id"><font color="#184f95" point-size="8"><b>PK, FK</b></font></td><td align="left"><font point-size="9">empresa_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="pausas_activas"><font point-size="8"> </font></td><td align="left"><font point-size="9">pausas_activas</font></td><td align="left"><font color="#7b7e8c" point-size="8">bool</font></td></tr><tr><td align="left" port="intervalo_minutos"><font point-size="8"> </font></td><td align="left"><font point-size="9">intervalo_minutos</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="actualizado_por"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">actualizado_por</font></td><td align="left"><font color="#7b7e8c" point-size="8">int ?</font></td></tr><tr><td></td><td align="left" colspan="2"><font color="#9a9890" point-size="8"><i>(+2 columnas más)</i></font></td></tr></table>>];
  sst_actividades [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#3b5bf0"><tr><td colspan="3" bgcolor="#3b5bf0"><font color="white" point-size="10"><b>sst_actividades</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="empresa_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">empresa_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="titulo"><font point-size="8"> </font></td><td align="left"><font point-size="9">titulo</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(120)</font></td></tr><tr><td align="left" port="area"><font point-size="8"> </font></td><td align="left"><font point-size="9">area</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(20)</font></td></tr><tr><td align="left" port="duracion_segundos"><font point-size="8"> </font></td><td align="left"><font point-size="9">duracion_segundos</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="activa"><font point-size="8"> </font></td><td align="left"><font point-size="9">activa</font></td><td align="left"><font color="#7b7e8c" point-size="8">bool</font></td></tr><tr><td></td><td align="left" colspan="2"><font color="#9a9890" point-size="8"><i>(+6 columnas más)</i></font></td></tr></table>>];
  sst_pausas [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#3b5bf0"><tr><td colspan="3" bgcolor="#3b5bf0"><font color="white" point-size="10"><b>sst_pausas</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">bigint</font></td></tr><tr><td align="left" port="empresa_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">empresa_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="usuario_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">usuario_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="actividad_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">actividad_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int ?</font></td></tr><tr><td align="left" port="actividad_titulo"><font point-size="8"> </font></td><td align="left"><font point-size="9">actividad_titulo</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(120)</font></td></tr><tr><td align="left" port="mostrada_en"><font point-size="8"> </font></td><td align="left"><font point-size="9">mostrada_en</font></td><td align="left"><font color="#7b7e8c" point-size="8">timestamptz</font></td></tr><tr><td align="left" port="estado"><font point-size="8"> </font></td><td align="left"><font point-size="9">estado</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(10)</font></td></tr><tr><td align="left" port="cerrada_en"><font point-size="8"> </font></td><td align="left"><font point-size="9">cerrada_en</font></td><td align="left"><font color="#7b7e8c" point-size="8">timestamptz ?</font></td></tr><tr><td></td><td align="left" colspan="2"><font color="#9a9890" point-size="8"><i>(+1 columnas más)</i></font></td></tr></table>>];
  usuarios [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#9a9890"><tr><td colspan="3" bgcolor="#9a9890"><font color="white" point-size="10"><b>usuarios</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="nombre"><font point-size="8"> </font></td><td align="left"><font point-size="9">nombre</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(150)</font></td></tr></table>>];
  sedes [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#9a9890"><tr><td colspan="3" bgcolor="#9a9890"><font color="white" point-size="10"><b>sedes</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="nombre"><font point-size="8"> </font></td><td align="left"><font point-size="9">nombre</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(150)</font></td></tr></table>>];
  sst_configuracion -> usuarios [arrowhead=teeodot];
  sst_pausas -> sst_actividades [arrowhead=teeodot];
  sst_pausas -> usuarios [arrowhead=tee];
}