="left"><font point-size="9">respuesta</font></td><td align="left"><font color="#7b7e8c" point-size="8">text ?</font></td></tr><tr><td align="left" port="respondida_por"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">respondida_por</font></td><td align="left"><font color="#7b7e8c" point-size="8">int ?</font></td></tr><tr><td></td><td align="left" colspan="2"><font color="#9a9890" point-size="8"><i>(+4 columnas más)</i></font></td></tr></table>>];
  pqrs_historial [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#3b5bf0"><tr><td colspan="3" bgcolor="#3b5bf0"><font color="white" point-size="10"><b>pqrs_historial</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">bigint</font></td></tr><tr><td align="left" port="pqrs_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">pqrs_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="usuario_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">usuario_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="fecha"><font point-size="8"> </font></td><td align="left"><font point-size="9">fecha</font></td><td align="left"><font color="#7b7e8c" point-size="8">timestamptz</font></td></tr><tr><td align="left" port="evento"><font point-size="8"> </font></td><td align="left"><font point-size="9">evento</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(15)</font></td></tr><tr><td align="left" port="estado_anterior"><font point-size="8"> </font></td><td align="left"><font point-size="9">estado_anterior</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(15) ?</font></td></tr><tr><td align="left" port="estado_nuevo"><font point-size="8"> </font></td><td align="left"><font point-size="9">estado_nuevo</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(15) ?</font></td></tr><tr><td></td><td align="left" colspan="2"><font color="#9a9890" point-size="8"><i>(+1 columnas más)</i></font></td></tr></table>>];
  sig_adjuntos [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#3b5bf0"><tr><td colspan="3" bgcolor="#3b5bf0"><font color="white" point-size="10"><b>sig_adjuntos</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="empresa_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">empresa_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="pqrs_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">pqrs_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int ?</font></td></tr><tr><td align="left" port="no_conformidad_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">no_conformidad_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int ?</font></td></tr><tr><td align="left" port="garantia_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">garantia_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int ?</font></td></tr><tr><td align="left" port="nombre"><font point-size="8"> </font></td><td align="left"><font point-size="9">nombre</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(200)</font></td></tr><tr><td align="left" port="tipo_mime"><font point-size="8"> </font></td><td align="left"><font point-size="9">tipo_mime</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(60)</font></td></tr><tr><td align="left" port="tamano"><font point-size="8"> </font></td><td align="left"><font point-size="9">tamano</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="sha256"><font point-size="8"> </font></td><td align="left"><font point-size="9">sha256</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(64)</font></td></tr><tr><td align="left" port="subido_por"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">subido_por</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td></td><td align="left" colspan="2"><font color="#9a9890" point-size="8"><i>(+2 columnas más)</i></font></td></tr></table>>];
  sedes [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#9a9890"><tr><td colspan="3" bgcolor="#9a9890"><font color="white" point-size="10"><b>sedes</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="nombre"><font point-size="8"> </font></td><td align="left"><font point-size="9">nombre</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(150)</font></td></tr></table>>];
  usuarios [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#9a9890"><tr><td colspan="3" bgcolor="#9a9890"><font color="white" point-size="10"><b>usuarios</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="nombre"><font point-size="8"> </font></td><td align="left"><font point-size="9">nombre</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(150)</font></td></tr></table>>];
  no_conformidades [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#9a9890"><tr><td colspan="3" bgcolor="#9a9890"><font color="white" point-size="10"><b>no_conformidades</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="numero"><font point-size="8"> </font></td><td align="left"><font point-size="9">numero</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr></table>>];
  garantias [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#9a9890"><tr><td colspan="3" bgcolor="#9a9890"><font color="white" point-size="10"><b>garantias</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="numero"><font point-size="8"> </font></td><td align="left"><font point-size="9">numero</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr></table>>];
  pqrs -> usuarios [arrowhead=tee label="2 FK" fontsize=8 fontcolor="#7b7e8c"];
  pqrs -> sedes [arrowhead=teeodot];
  pqrs_historial -> pqrs [arrowhead=tee];
  pqrs_historial -> usuarios [arrowhead=tee];
  sig_adjuntos -> garantias [arrowhead=teeodot];
  sig_adjuntos -> no_conformidades [arrowhead=teeodot];
  sig_adjuntos -> pqrs [arrowhead=teeodot];
  sig_adjuntos -> usuarios [arrowhead=tee];
