  recomendaciones [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#3b5bf0"><tr><td colspan="3" bgcolor="#3b5bf0"><font color="white" point-size="10"><b>recomendaciones</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="empresa_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">empresa_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="ejecucion_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">ejecucion_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int ?</font></td></tr><tr><td align="left" port="tipo"><font point-size="8"> </font></td><td align="left"><font point-size="9">tipo</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(20)</font></td></tr><tr><td align="left" port="producto_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">producto_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="sede_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">sede_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="sede_origen_id"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">sede_origen_id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int ?</font></td></tr><tr><td align="left" port="cantidad_sugerida"><font point-size="8"> </font></td><td align="left"><font point-size="9">cantidad_sugerida</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="prioridad"><font point-size="8"> </font></td><td align="left"><font point-size="9">prioridad</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(10)</font></td></tr><tr><td align="left" port="estado"><font point-size="8"> </font></td><td align="left"><font point-size="9">estado</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(15)</font></td></tr><tr><td align="left" port="justificacion"><font point-size="8"> </font></td><td align="left"><font point-size="9">justificacion</font></td><td align="left"><font color="#7b7e8c" point-size="8">jsonb</font></td></tr><tr><td align="left" port="revisada_por"><font color="#eb6834" point-size="8"><b>FK</b></font></td><td align="left"><font point-size="9">revisada_por</font></td><td align="left"><font color="#7b7e8c" point-size="8">int ?</font></td></tr><tr><td></td><td align="left" colspan="2"><font color="#9a9890" point-size="8"><i>(+4 columnas más)</i></font></td></tr></table>>];
  sedes [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#9a9890"><tr><td colspan="3" bgcolor="#9a9890"><font color="white" point-size="10"><b>sedes</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="nombre"><font point-size="8"> </font></td><td align="left"><font point-size="9">nombre</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(150)</font></td></tr></table>>];
  productos [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#9a9890"><tr><td colspan="3" bgcolor="#9a9890"><font color="white" point-size="10"><b>productos</b></font></td></tr><tr><td align="left" port="id"><font color="#184f95" point-size="8"><b>PK</b></font></td><td align="left"><font point-size="9">id</font></td><td align="left"><font color="#7b7e8c" point-size="8">int</font></td></tr><tr><td align="left" port="codigo"><font point-size="8"> </font></td><td align="left"><font point-size="9">codigo</font></td><td align="left"><font color="#7b7e8c" point-size="8">varchar(60)</font></td></tr></table>>];
