digraph G {
graph [rankdir=TB, splines=true, nodesep=0.6, ranksep=0.55, pad=0.3, fontname="Inter"];
node [shape=plain, fontname="Inter"];
edge [fontname="Inter", fontsize=9, color="#52514e", arrowhead=none, labelfontsize=9, labeldistance=1.7, labelangle=25];
Categoria [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="white"><TR><TD BGCOLOR="#eef1ff" BORDER="0"><B>Categoria</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">id: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">nombre: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">activa: bool</FONT></TD></TR><HR/><TR><TD BORDER="0"> </TD></TR></TABLE>>];
Producto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="white"><TR><TD BGCOLOR="#eef1ff" BORDER="0"><B>Producto</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">id: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">codigo: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">nombre: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">unidad_medida: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">costo: Decimal?</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">precio_venta: Decimal?</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">activo: bool</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">crear()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">inhabilitar()</FONT></TD></TR></TABLE>>];
InventarioSede [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="white"><TR><TD BGCOLOR="#eef1ff" BORDER="0"><B>InventarioSede</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">cantidad: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">stock_minimo: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">stock_maximo: int?</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">registrar_entrada()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">registrar_salida()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">ajustar()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">configurar_niveles()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">consolidado()</FONT></TD></TR></TABLE>>];
Movimiento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="white"><TR><TD BGCOLOR="#eef1ff" BORDER="0"><B>Movimiento</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">id: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">tipo: TipoMovimiento</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">motivo: str?</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">delta: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">saldo_anterior: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">saldo_posterior: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">fecha: datetime</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">(solo inserción)</FONT></TD></TR></TABLE>>];
Alerta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="white"><TR><TD BGCOLOR="#eef1ff" BORDER="0"><B>Alerta</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">id: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">tipo: TipoAlerta</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">prioridad: PrioridadAlerta</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">estado: EstadoAlerta</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">mensaje: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">abierta_en: datetime</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">sincronizar()</FONT></TD></TR></TABLE>>];
Empresa [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#b9b8b2" BGCOLOR="#f3f2ee" STYLE="dashed"><TR><TD BORDER="0"><B>Empresa</B></TD></TR><HR/><TR><TD BORDER="0"><FONT POINT-SIZE="9" COLOR="#52514e">(ver otro diagrama)</FONT></TD></TR></TABLE>>];
Sede [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#b9b8b2" BGCOLOR="#f3f2ee" STYLE="dashed"><TR><TD BORDER="0"><B>Sede</B></TD></TR><HR/><TR><TD BORDER="0"><FONT POINT-SIZE="9" COLOR="#52514e">(ver otro diagrama)</FONT></TD></TR></TABLE>>];
{rank=same; Empresa; Sede}
{rank=same; Categoria; InventarioSede}
{rank=same; Producto; Movimiento; Alerta}
Empresa -> Categoria [label="organiza", taillabel="1", headlabel="*", fontcolor="#52514e", labelfontcolor="#0b0b0b"];
Categoria -> Producto [label="agrupa", taillabel="0..1", headlabel="*", fontcolor="#52514e", labelfontcolor="#0b0b0b"];
Sede -> InventarioSede [label="mantiene", taillabel="1", headlabel="*", fontcolor="#52514e", labelfontcolor="#0b0b0b"];
Producto -> InventarioSede [label="se almacena", taillabel="1", headlabel="*", fontcolor="#52514e", labelfontcolor="#0b0b0b"];
InventarioSede -> Movimiento [label="registra", taillabel="1", headlabel="*", fontcolor="#52514e", labelfontcolor="#0b0b0b"];
InventarioSede -> Alerta [label="genera", taillabel="1", headlabel="*", fontcolor="#52514e", labelfontcolor="#0b0b0b"];
}