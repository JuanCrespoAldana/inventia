digraph G {
graph [rankdir=TB, splines=true, nodesep=0.6, ranksep=1.3, pad=0.3, fontname="Inter"];
node [shape=plain, fontname="Inter"];
edge [fontname="Inter", fontsize=9, color="#52514e", arrowhead=none, labelfontsize=9, labeldistance=1.7, labelangle=25];
Venta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="white"><TR><TD BGCOLOR="#eef1ff" BORDER="0"><B>Venta</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">id: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">numero: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">fecha: datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">total: Decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">estado: EstadoVenta</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">motivo_anulacion: str?</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">registrar()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">anular()</FONT></TD></TR></TABLE>>];
VentaItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="white"><TR><TD BGCOLOR="#eef1ff" BORDER="0"><B>VentaItem</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">cantidad: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">precio_unitario: Decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">subtotal: Decimal</FONT></TD></TR><HR/><TR><TD BORDER="0"> </TD></TR></TABLE>>];
Traslado [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="white"><TR><TD BGCOLOR="#eef1ff" BORDER="0"><B>Traslado</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">id: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">numero: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">estado: EstadoTraslado</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">solicitado_en: datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">aprobado_en: datetime?</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">confirmado_en: datetime?</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">motivo_cierre: str?</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">solicitar()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">aprobar()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">rechazar()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">cancelar()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">confirmar()</FONT></TD></TR></TABLE>>];
TrasladoItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="white"><TR><TD BGCOLOR="#eef1ff" BORDER="0"><B>TrasladoItem</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">cantidad: int</FONT></TD></TR><HR/><TR><TD BORDER="0"> </TD></TR></TABLE>>];
Producto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#b9b8b2" BGCOLOR="#f3f2ee" STYLE="dashed"><TR><TD BORDER="0"><B>Producto</B></TD></TR><HR/><TR><TD BORDER="0"><FONT POINT-SIZE="9" COLOR="#52514e">(ver otro diagrama)</FONT></TD></TR></TABLE>>];
Sede [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#b9b8b2" BGCOLOR="#f3f2ee" STYLE="dashed"><TR><TD BORDER="0"><B>Sede</B></TD></TR><HR/><TR><TD BORDER="0"><FONT POINT-SIZE="9" COLOR="#52514e">(ver otro diagrama)</FONT></TD></TR></TABLE>>];
Movimiento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#b9b8b2" BGCOLOR="#f3f2ee" STYLE="dashed"><TR><TD BORDER="0"><B>Movimiento</B></TD></TR><HR/><TR><TD BORDER="0"><FONT POINT-SIZE="9" COLOR="#52514e">(ver otro diagrama)</FONT></TD></TR></TABLE>>];
{rank=same; Traslado; Sede; Venta}
{rank=same; TrasladoItem; VentaItem}
{rank=same; Producto; Movimiento}
Venta -> Movimiento [label="produce", taillabel="0..1", headlabel="*", fontcolor="#52514e", labelfontcolor="#0b0b0b"];
Venta -> VentaItem [label="contiene", taillabel="1", headlabel="1..*", fontcolor="#52514e", labelfontcolor="#0b0b0b"];
VentaItem -> Producto [label="vende", taillabel="*", headlabel="1", fontcolor="#52514e", labelfontcolor="#0b0b0b"];
Sede -> Venta [label="registra", taillabel="1", headlabel="*", fontcolor="#52514e", labelfontcolor="#0b0b0b"];
Traslado -> TrasladoItem [label="contiene", taillabel="1", headlabel="1..*", fontcolor="#52514e", labelfontcolor="#0b0b0b"];
TrasladoItem -> Producto [label="mueve", taillabel="*", headlabel="1", fontcolor="#52514e", labelfontcolor="#0b0b0b"];
Traslado -> Movimiento [label="produce", taillabel="0..1", headlabel="*", fontcolor="#52514e", labelfontcolor="#0b0b0b"];
Traslado -> Sede [label="origen y destino", taillabel="*", headlabel="2", fontcolor="#52514e", labelfontcolor="#0b0b0b"];
}