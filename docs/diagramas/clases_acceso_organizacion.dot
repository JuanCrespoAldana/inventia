digraph G {
graph [rankdir=TB, splines=true, nodesep=0.6, ranksep=1.3, pad=0.3, fontname="Inter"];
node [shape=plain, fontname="Inter"];
edge [fontname="Inter", fontsize=9, color="#52514e", arrowhead=none, labelfontsize=9, labeldistance=1.7, labelangle=25];
Empresa [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="white"><TR><TD BGCOLOR="#eef1ff" BORDER="0"><B>Empresa</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">id: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">nombre: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">identificacion: str?</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">ciudad: str?</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">activa: bool</FONT></TD></TR><HR/><TR><TD BORDER="0"> </TD></TR></TABLE>>];
Sede [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="white"><TR><TD BGCOLOR="#eef1ff" BORDER="0"><B>Sede</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">id: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">nombre: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">ciudad: str?</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">activa: bool</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">crear()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">inhabilitar()</FONT></TD></TR></TABLE>>];
Usuario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="white"><TR><TD BGCOLOR="#eef1ff" BORDER="0"><B>Usuario</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">id: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">nombre: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">email: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">activo: bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">debe_cambiar_password: bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">intentos_fallidos: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">bloqueado_hasta: datetime?</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">iniciar_sesion()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">cerrar_sesion()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">cambiar_password()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">recuperar_password()</FONT></TD></TR></TABLE>>];
Rol [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="white"><TR><TD BGCOLOR="#eef1ff" BORDER="0"><B>Rol</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">id: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">clave: str?</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">nombre: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">alcance: AlcanceRol</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">es_sistema: bool</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">asignar_permisos()</FONT></TD></TR></TABLE>>];
Permiso [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="white"><TR><TD BGCOLOR="#eef1ff" BORDER="0"><B>Permiso</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">codigo: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">modulo: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">descripcion: str</FONT></TD></TR><HR/><TR><TD BORDER="0"> </TD></TR></TABLE>>];
Auditoria [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="white"><TR><TD BGCOLOR="#eef1ff" BORDER="0"><B>Auditoria</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">id: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">fecha: datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">modulo: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">accion: str</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">entidad: str?</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">resultado: ResultadoAuditoria</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">ip: str?</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10" COLOR="#184f95">(solo inserción)</FONT></TD></TR></TABLE>>];
{rank=same; Usuario; Rol}
{rank=same; Sede; Permiso}
Empresa -> Sede [label="tiene", taillabel="1", headlabel="1..*", fontcolor="#52514e", labelfontcolor="#0b0b0b"];
Empresa -> Usuario [label="emplea", taillabel="1", headlabel="1..*", fontcolor="#52514e", labelfontcolor="#0b0b0b"];
Empresa -> Rol [label="define", taillabel="1", headlabel="1..*", fontcolor="#52514e", labelfontcolor="#0b0b0b"];
Rol -> Permiso [label="concede", taillabel="*", headlabel="*", fontcolor="#52514e", labelfontcolor="#0b0b0b"];
Usuario -> Rol [label="tiene", taillabel="*", headlabel="1", fontcolor="#52514e", labelfontcolor="#0b0b0b"];
Usuario -> Sede [label="opera en", taillabel="*", headlabel="0..1", fontcolor="#52514e", labelfontcolor="#0b0b0b"];
Usuario -> Auditoria [label="deja", taillabel="0..1", headlabel="*", fontcolor="#52514e", labelfontcolor="#0b0b0b"];
}